# 외부 접속용 웹 포트 (마라톤 42.195km 테마 포트)
FRONTEND_PORT=42195

# Go 서버 수신 주소
HTTP_ADDR=:3000

# 서버에서 실행 중인 postgres 컨테이너를 가리키도록 설정
# DATABASE_URL=postgres://<유저>:<비밀번호>@postgres:5432/<DB이름>?sslmode=disable&search_path=core
DATABASE_URL=postgres://fitlab:change-me@postgres:5432/fitlab?sslmode=disable&search_path=core
